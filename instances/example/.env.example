# ============================================================================
# discord-bot-rs — Example Instance Secrets
# ============================================================================
#
# Copy this file to `.env` in the same directory, then fill in the values.
# `.env` is gitignored; never commit one.
#
# Full documentation: https://mrmcepic.github.io/discord-bot-rs/configuration/environment-variables/
# ============================================================================


# ----- Discord (required) ---------------------------------------------------

# Get these from https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token
CLIENT_ID=your-application-client-id
GUILD_ID=your-discord-server-id


# ----- Database (required) --------------------------------------------------

# Connection string for PostgreSQL. If you're using the bundled postgres
# service from docker-compose.yml, leave this as-is.
DATABASE_URL=postgresql://discord_bot:discord_bot_pass@postgres:5432/discord_bot

# Postgres schema name — isolates this instance's data from others in the
# same database. Typically matches your instance directory name.
DB_SCHEMA=example


# ----- AI Providers (optional) ----------------------------------------------
#
# DeepSeek is the default text-chat provider. Gemini is used for image
# vision (when present in messages or replied-to messages). Grok is used
# only as a CENSORED-cascade fallback when [ai.fallback] in config.toml
# lists "grok" — see instances/example/config.toml for the cascade syntax.
# Any one of the three may be unset.

DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=


# ----- Stock Trading (optional) ---------------------------------------------
#
# Required only if you use the virtual stock trading feature.
# Get a free key at https://finnhub.io/

FINNHUB_API_KEY=


# ----- Minecraft Integration (optional) -------------------------------------
#
# Required only when features.minecraft = true in config.toml.
# The MC server runs a companion plugin that exposes these endpoints.

MC_VERIFY_URL=
MC_VERIFY_SECRET=


# ----- MCP Server (optional) ------------------------------------------------
#
# The bot embeds a Model Context Protocol server for programmatic Discord
# management. Used by Claude Code and other MCP clients.
#
# MCP_BIND_ADDR=0.0.0.0 is required for the bundled docker-compose setup
# because the mcp-gateway sidecar reaches the bot via the Docker network as
# `http://bot:9090`. If you're running outside Docker on a single host and
# only want loopback access, set this to 127.0.0.1.

MCP_PORT=9090
MCP_BIND_ADDR=0.0.0.0
MCP_AUTH_TOKEN=

# The `mcp-gateway` service is configured separately: set
# MCP_GATEWAY_AUTH_TOKEN (same value as MCP_AUTH_TOKEN above) in a `.env`
# at the repo root — Docker Compose reads it there and forwards it to the
# gateway. See docs/getting-started/quickstart.md for the one-liner.
