# Discord Bot Credentials (required)
DISCORD_TOKEN=your-discord-bot-token
CLIENT_ID=your-client-id
GUILD_ID=your-guild-id

# Database
DATABASE_URL=postgresql://discord_bot:discord_bot_pass@postgres:5432/discord_bot
DB_SCHEMA=mybot

# AI API Keys (optional - features degrade gracefully without them)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
FINNHUB_API_KEY=

# Minecraft Verification (optional - only if features.minecraft = true in config.toml)
MC_VERIFY_URL=
MC_VERIFY_SECRET=

# MCP Server (management API for Claude Code)
MCP_PORT=9090
MCP_BIND_ADDR=127.0.0.1
MCP_AUTH_TOKEN=
